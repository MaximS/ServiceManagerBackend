{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServiceManager": {
    "Services": [
      "example-sleep"
    ],
    "Sequences": {
      "StartAll": [
        "example-sleep"
      ],
      "StopAll": [
        "example-sleep"
      ]
    },
    "JobTimeoutSeconds": 600
  }
}
