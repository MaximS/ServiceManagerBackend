{"nodes": [{"id": "docs_02_systemd_dbus_api", "label": "systemd over D-Bus: org.freedesktop.systemd1 API (Part 2)", "file_type": "document", "source_file": "docs/02-systemd-dbus-api.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_02_systemd_dbus_api_org_freedesktop_systemd1", "label": "org.freedesktop.systemd1 service", "file_type": "concept", "source_file": "docs/02-systemd-dbus-api.md", "source_location": "## 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_02_systemd_dbus_api_manager", "label": "org.freedesktop.systemd1.Manager interface", "file_type": "concept", "source_file": "docs/02-systemd-dbus-api.md", "source_location": "## 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_02_systemd_dbus_api_unit", "label": "org.freedesktop.systemd1.Unit interface", "file_type": "concept", "source_file": "docs/02-systemd-dbus-api.md", "source_location": "## 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_02_systemd_dbus_api_job", "label": "org.freedesktop.systemd1.Job interface", "file_type": "concept", "source_file": "docs/02-systemd-dbus-api.md", "source_location": "## 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_02_systemd_dbus_api_unit_path_encoding", "label": "Unit-name to object-path encoding", "file_type": "rationale", "source_file": "docs/02-systemd-dbus-api.md", "source_location": "## 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every non-alphanumeric character becomes '_' + two lowercase hex digits of the char code (e.g. . -> _2e, - -> _2d, @ -> _40). Prefer GetUnit/LoadUnit round-trips over computing paths by hand; compute only when a signal handler already carries the name."}, {"id": "docs_02_systemd_dbus_api_job_modes", "label": "Job mode strings (fail/replace/isolate/...)", "file_type": "concept", "source_file": "docs/02-systemd-dbus-api.md", "source_location": "## 2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_02_systemd_dbus_api_job_results", "label": "Job result strings (done/failed/...)", "file_type": "concept", "source_file": "docs/02-systemd-dbus-api.md", "source_location": "## 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_02_systemd_dbus_api_job_completion_dance", "label": "Job-completion dance", "file_type": "rationale", "source_file": "docs/02-systemd-dbus-api.md", "source_location": "## 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "StartUnit returns when the job is enqueued, not when it finishes. To know the outcome: Subscribe, install a JobRemoved handler BEFORE the method call, then match on the returned job path. Race-free because D-Bus delivers messages on one connection in order (method return always precedes the JobRemoved signal). Do not poll ListJobs or Unit.Job in a loop \u2014 the signal approach is exact and allocation-free."}, {"id": "docs_02_systemd_dbus_api_subscribe", "label": "Manager.Subscribe() signal gating", "file_type": "rationale", "source_file": "docs/02-systemd-dbus-api.md", "source_location": "## 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "systemd suppresses most signals (JobRemoved, unit PropertiesChanged) unless at least one client has called Manager.Subscribe() on its connection; it is a per-connection flag and emission stops when the last subscriber disconnects or unsubscribes. A client that only calls ListUnits never needs it; any signal watcher must Subscribe() first or silently receive nothing."}, {"id": "docs_02_systemd_dbus_api_jobremoved", "label": "JobRemoved signal", "file_type": "concept", "source_file": "docs/02-systemd-dbus-api.md", "source_location": "## 2.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_02_systemd_dbus_api_startunit", "label": "Manager.StartUnit(name, mode)", "file_type": "concept", "source_file": "docs/02-systemd-dbus-api.md", "source_location": "## 2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_02_systemd_dbus_api_getunit", "label": "Manager.GetUnit / LoadUnit", "file_type": "concept", "source_file": "docs/02-systemd-dbus-api.md", "source_location": "## 2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_02_systemd_dbus_api_listunits", "label": "Manager.ListUnits", "file_type": "concept", "source_file": "docs/02-systemd-dbus-api.md", "source_location": "## 2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_02_systemd_dbus_api_enableunitfiles", "label": "EnableUnitFiles / DisableUnitFiles", "file_type": "concept", "source_file": "docs/02-systemd-dbus-api.md", "source_location": "## 2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_02_systemd_dbus_api_state_properties", "label": "Unit state properties (ActiveState/LoadState/SubState)", "file_type": "concept", "source_file": "docs/02-systemd-dbus-api.md", "source_location": "## 3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_02_systemd_dbus_api_polkit_actions", "label": "systemd polkit actions (manage-units, manage-unit-files, ...)", "file_type": "concept", "source_file": "docs/02-systemd-dbus-api.md", "source_location": "## 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_02_systemd_dbus_api_error_names", "label": "D-Bus error names systemd emits", "file_type": "concept", "source_file": "docs/02-systemd-dbus-api.md", "source_location": "## 8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {